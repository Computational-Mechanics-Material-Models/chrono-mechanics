std::shared_ptr<ChBody> AddTopWall(ChSystem& sys) {
    
    // The fixed body (5 walls)
    // Contact material for container
    
    auto fixed_mat = chrono_types::make_shared<ChContactMaterialSMC>();    
    fixed_mat->SetYoungModulus(1e2); //2e3
    fixed_mat->SetFriction(0.5);
    fixed_mat->SetRestitution(0.0f);
    fixed_mat->SetAdhesion(0);
    //auto fixedBody = chrono_types::make_shared<ChBody>();
    
    auto fixedBody=chrono_types::make_shared<ChBodyEasyBox>(100, 10, 100, 2.4e-9, true, true, fixed_mat);    
    fixedBody->SetFixed(true);
    fixedBody->SetPos(ChVector3d(0, 305, 0));
    fixedBody->GetVisualShape(0)->SetTexture(GetChronoDataFile("textures/pinkwhite.png")); //("textures/concrete.jpg"));
    //fixedBody->GetVisualShape(0)->SetOpacity(opacity_val);
	
    fixedBody->GetCollisionModel()->SetFamilyGroup(2);
    fixedBody->GetCollisionModel()->DisallowCollisionsWith(1);
    //fixedBody->GetCollisionModel()->SetFamilyMaskDoCollisionWithFamily(0);
	
    sys.AddBody(fixedBody);
    return fixedBody;
	
}

// ---------------Slump Cone -------------------------------------------------------

std::shared_ptr<ChBody> AddSlumpCone(ChSystem& sys, std::shared_ptr<ChContactMaterial> mat, double density, double radius, double height, std::string current_dir) {
    // create SlumpCone 
   
	auto SlumpCone = chrono_types::make_shared<ChBodyEasyMesh>(
        (current_dir+"/coni_100_50_300.obj").c_str(),
        density,      // density of the body
        true,         // automatic evaluation of mass, COG position, inertia tensor
        true,         // attach visualization asset
        true,         // enable the collision detection
        mat,          // surface contact material
        1.0           // radius of 'inflating' of mesh (for more robust collision detection)
    );	
	//
	//ChQuaterniond q=QuatFromAngleAxis(CH_PI_2, VECT_Z);	
	ChQuaternion<> q;
	q.SetFromAngleAxis(CH_PI_2, VECT_Z); //mini slump
	SlumpCone->SetRot(q);
	std::cout << "COG : " << SlumpCone->GetFrameCOMToAbs().GetPos() << std::endl;
	SlumpCone->SetPos(ChVector3d(0,133,0));
	//SlumpCone->GetVisualShape(0)->GetMaterial(0)->SetOpacity(0.5);
	//SlumpCone->SetFixed(true);	
    sys.AddBody(SlumpCone); 
    return SlumpCone;	
	
}

/////////////////////////////////////////////////////////////////////////////////
void ReadDFCparticles(ChSystem& sys, std::shared_ptr<ChVisualSystemIrrlicht>& vis, std::string& data_path, std::string& file_name, double rho, double h_layer) {
    auto mat = chrono_types::make_shared<ChContactMaterialSMC>();
    mat->SetYoungModulus(1e2); //2e3
    mat->SetFriction(0.5);
    mat->SetRestitution(0.0f);
    mat->SetAdhesion(0);
	
	struct ParticleData {
		int n;		// no
		double x;   // x coordinate
		double y;	// y coordinate
		double z;	// z coordinate	
		double d;	// diameter 
	};

	
	std::string nodesFilename=data_path+file_name+".dat";
	std::ifstream nodesFile(nodesFilename);    
	// ================================================================================
	// Particle Data File
	// ================================================================================
	//
	// Data Structure:
	// n x y z d
	//
	// ================================================================================
	std::vector<ParticleData> particles;
	ParticleData temp;
	if (nodesFile.is_open()) {  		
		std::string line; 
	    	while (std::getline(nodesFile, line)) {
			std::istringstream iss(line);
			if (!(iss >> temp.n >> temp.x >> temp.y >> temp.z >> temp.d )) {            
		    		continue;
			}
		particles.push_back(temp);
    	}
	}

	ChQuaternion<> q;
	q.SetFromAngleAxis(-CH_PI_2, VECT_X);
	ChVector3d t(0,0,0);
	ChCoordsysd csys(t, q);
	
	for (auto particle:particles) {
        float x_pos=particle.x;
        float y_pos=particle.y;
        float z_pos=particle.z;
       
	    
        ChVector3d pos={x_pos, y_pos, z_pos};            
        //ChVector3d rotatedpos = rot.Rotate(pos);
		//ChVector3d rotatedpos=ChTransform<>::TransformParentToLocal(pos, t, q);
		ChVector3d rotatedpos=csys.TransformPointLocalToParent(pos);
		std::cout<<"pos: "<<pos<<"\t";
		std::cout<<"rotated pos: "<<rotatedpos<<"\n";
		
		double radius=particle.d/2+h_layer;
		double mass = rho/2*4/3*pow(radius, 3)*CH_PI;
					
		auto body = chrono_types::make_shared<ChBody>();
		body->SetInertiaXX((2.0 / 5.0) * mass * pow(radius, 2) * ChVector3d(1, 1, 1));
		body->SetMass(mass);
		//body->SetPos(ChVector3d(11 * ix , 50+11*iy, 11 * iz));
		body->SetPos(rotatedpos);
		auto sphere_shape = chrono_types::make_shared<ChCollisionShapeSphere>(mat, radius);
    	body->AddCollisionShape(sphere_shape);    
    	body->EnableCollision(true);
    		
        auto sphereMor = chrono_types::make_shared<ChVisualShapeSphere>(radius);	
    	//sphereMor->SetTexture(GetChronoDataFile("textures/concrete.jpg"));
    	sphereMor->SetColor(ChColor(128.f/255, 128.f/255, 128.f/255));
		sphereMor->SetOpacity(0.6f);
    	body->AddVisualShape(sphereMor);
		auto sphereAgg = chrono_types::make_shared<ChVisualShapeSphere>(radius-h_layer);			
		sphereAgg->SetColor(ChColor(5.f/255, 48.f/255, 173.f/255));	
		body->AddVisualShape(sphereAgg);
	
		vis->BindItem(body);	
		sys.AddBody(body);
		      
    }
    
}

///////////////////////////////////////////////////////////////////////////////////////////////////////
std::string getCurrentDirectory() {
    char buffer[260];

#ifdef _WIN32
    GetModuleFileName(NULL, buffer, 260);
    std::string path(buffer);
    return path.substr(0, path.find_last_of("\\/"));
#else
    ssize_t count = readlink("/proc/self/exe", buffer, 260);
    std::string path(buffer);
    return path.substr(0, path.find_last_of("/")-5);
#endif
}
